#!/usr/local/bin/node
const { spawn } = require("node:child_process");

const SUPERVISOR = "scripts/run-apps.js";

const commands = {
  start: { args: [SUPERVISOR, "start", "dist/index.js"], env: {} },
  "start:with-tracing": {
    args: [
      SUPERVISOR,
      "start",
      "dist/index.js",
      "--require",
      "./dist/tracing.js",
    ],
    env: { TRACING_ENABLED: "true" },
  },
};

const cmd = process.argv[2];
const command = commands[cmd];
if (!command) {
  process.stdout.write(
    JSON.stringify({
      level: 50,
      time: Date.now(),
      msg: `start-shim: "${cmd}" is not supported on this image (only start / start:with-tracing are)`,
    }) + "\n",
  );
  process.exit(1);
}

const child = spawn(process.execPath, command.args, {
  stdio: "inherit",
  env: { ...process.env, ...command.env },
});

for (const signal of ["SIGTERM", "SIGINT"]) {
  process.on(signal, () => child.kill(signal));
}

child.on("exit", (code) => process.exit(code ?? 1));
